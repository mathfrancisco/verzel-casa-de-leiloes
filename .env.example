# Copie para .env e preencha. Nunca comite o .env.
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

DATABASE_URL=postgres://leilao:leilao@localhost:5432/leilao
JWT_SECRET=
# Par Ed25519 gerado por `pnpm keys:generate`: privada PEM PKCS#8 em variável secreta;
# pública base64url em `audit-signing-public.key`.
AUDIT_SIGNING_PRIVATE_KEY=
AUDIT_SIGNING_PUBLIC_KEY=
PSEUDONYM_SECRET=
# artic | fake
CATALOG_PROVIDER=artic
PORT=3000
NODE_ENV=development
