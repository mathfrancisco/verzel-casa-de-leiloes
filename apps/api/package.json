{
  "name": "@leilao/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/infra/db/migrate.ts",
    "keys:generate": "tsx scripts/generateAuditKeys.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/jwt": "9.1.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.2.0",
    "@leilao/shared": "workspace:*",
    "argon2": "0.43.0",
    "drizzle-orm": "0.44.2",
    "fastify": "5.4.0",
    "postgres": "3.4.7",
    "socket.io": "4.8.1",
    "uuid": "11.1.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/node": "22.15.32",
    "drizzle-kit": "0.31.1",
    "socket.io-client": "4.8.1",
    "tsup": "8.5.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
