{
  "name": "verzel-casa-de-leiloes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @leilao/api --filter @leilao/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @leilao/api db:generate",
    "db:migrate": "pnpm --filter @leilao/api db:migrate",
    "seed": "pnpm --filter @leilao/api seed",
    "seed:reset": "pnpm --filter @leilao/api seed:reset",
    "keys:generate": "pnpm --filter @leilao/api keys:generate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.29.0",
    "@playwright/test": "1.64.1",
    "eslint": "9.29.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.2.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1"
  }
}
